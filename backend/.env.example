# ================================================================
# EduPay Tracker — Backend Environment Configuration & Connection Keys
# ================================================================

# Application Port
PORT=3000

# PostgreSQL Database Connection (Cloud SQL / Supabase / Self-hosted Postgres)
# In Google AI Studio, these are automatically injected by the Cloud SQL proxy.
SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD="your-secure-password"
SQL_DB_NAME="edupay_db"

# Admin credentials for running Drizzle Kit schema migrations
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your-admin-password"

# Firebase Auth / Project Configuration
FIREBASE_PROJECT_ID="sinuous-woodland-kf38q"

# Paystack API Keys (replace with your live or test keys from dashboard.paystack.com)
PAYSTACK_PUBLIC_KEY="pk_test_edupay_demo_key_9831"
PAYSTACK_SECRET_KEY="sk_test_edupay_demo_key_4412"

# Frontend Origin URL (optional for strict CORS white-listing)
FRONTEND_URL="http://localhost:5173"
